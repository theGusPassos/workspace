{
  "model": "opus",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)"
    ]
  }
}
